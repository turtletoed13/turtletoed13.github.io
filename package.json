{
  "name": "eyefind",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-static.mjs && next dev",
    "build": "npm run validate && node scripts/sync-static.mjs && next build",
    "vercel-build": "npm run validate && node scripts/sync-static.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit && node --input-type=module --check < app.js",
    "validate": "node --input-type=module --check < app.js && node scripts/validate-catalogue.mjs",
    "test:catalogue": "node scripts/validate-catalogue.mjs"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
